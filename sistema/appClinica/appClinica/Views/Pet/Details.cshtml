@model appClinica.Models.Pet
@{
    ViewData["Title"] = "Detalhes do Pet";
}
<h1>Detalhes do Pet</h1>
<dl class="row">
    <dt class="col-sm-3">Nome</dt>
    <dd class="col-sm-9">@Model.Nome</dd>
    <dt class="col-sm-3">Espécie</dt>
    <dd class="col-sm-9">@Model.Especie</dd>
    <dt class="col-sm-3">Raça</dt>
    <dd class="col-sm-9">@Model.Raca</dd>
    <dt class="col-sm-3">Tutor</dt>
    <dd class="col-sm-9">@Model.Tutor?.Nome</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Codigo" class="btn btn-warning">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>