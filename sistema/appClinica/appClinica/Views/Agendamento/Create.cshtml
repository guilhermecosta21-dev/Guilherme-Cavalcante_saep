@model appClinica.Models.Agendamento
@{
    ViewData["Title"] = "Novo Agendamento";
}
<h1>Novo Agendamento</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="DataAgendamento" class="control-label"></label>
                <input asp-for="DataAgendamento" class="form-control" type="datetime-local" />
                <span asp-validation-for="DataAgendamento" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="TutorId" class="control-label">Tutor</label>
                <select asp-for="TutorId" class="form-control" asp-items="ViewBag.TutorId">
                    <option value="">-- Selecione o Tutor --</option>
                </select>
                <span asp-validation-for="TutorId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PetId" class="control-label">Pet</label>
                <select asp-for="PetId" class="form-control" asp-items="ViewBag.PetId">
                    <option value="">-- Selecione o Pet --</option>
                </select>
                <span asp-validation-for="PetId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="MedicoId" class="control-label">Médico Veterinário</label>
                <select asp-for="MedicoId" class="form-control" asp-items="ViewBag.MedicoId">
                    <option value="">-- Selecione o Médico --</option>
                </select>
                <span asp-validation-for="MedicoId" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Agendar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Voltar</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
 }